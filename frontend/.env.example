# Frontend Environment Variables for Vercel Deployment

# 1. Backend REST API URL (Render / Railway / Fly.io / VPS)
NEXT_PUBLIC_API_URL=https://your-zoom-backend.onrender.com/api

# 2. WebSocket Signaling Server URL (wss:// for SSL on production)
NEXT_PUBLIC_WS_URL=wss://your-zoom-backend.onrender.com/ws
